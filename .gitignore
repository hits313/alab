# binaries / large blobs — pull these yourself per install guide
frida/frida-server
frida/*.xz
magisk/*.apk
jadx/
dex2jar/

# target APKs (never commit clients' code)
apks/
*.apk

# Burp / proxy certs — per-user, never commit
burp/
*.der
*.pem
*.cer
*.crt
*.p12
*.pfx
*.key
.cert-hash

# hunt output (target-specific, may contain client data)
hunt/
/tmp/hunt-*

# emulator state
*.log
*.lock
hardware-qemu.ini.lock

# editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# python
__pycache__/
*.pyc
.venv/

# claude / agent state
.claude/projects/
.claude/todos/
